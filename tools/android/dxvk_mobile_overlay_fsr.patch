--- /dev/null
+++ b/src/dxvk/shaders/dxvk_present_frag_easu.frag
@@ -0,0 +1,122 @@
+#version 450
+
+// Port (Rayman Origins PC, Android): the game drawn below the screen's resolution (the launcher's quality modes) is
+// enlarged with AMD FidelityFX Super Resolution 1.0's EASU (edge-adaptive spatial upsampling) instead of bilinear:
+// sharper edges for the same cost class. A GLSL port of FsrEasuF from ffx_fsr1.h (MIT licence, Copyright (c) 2021
+// Advanced Micro Devices, Inc.), with texelFetch taps (the present sampler uses pixel coordinates, which gathers
+// may not). The position comes from the interpolated coordinate, so it works the same on a pre-rotated swap chain.
+
+layout(constant_id = 1) const bool s_gamma_bound = true;
+
+layout(binding = 0) uniform sampler2D s_image;
+layout(binding = 1) uniform sampler1D s_gamma;
+
+layout(location = 0) in  vec2 i_coord;
+layout(location = 0) out vec4 o_color;
+
+layout(push_constant)
+uniform present_info_t {
+  ivec2 src_offset;
+  uvec2 src_extent;
+};
+
+vec3 tap(ivec2 p) {
+  p = clamp(p, src_offset, src_offset + ivec2(src_extent) - 1);
+  return texelFetch(s_image, p, 0).rgb;
+}
+
+float rcpLo(float a) { return uintBitsToFloat(0x7ef07ebbu - floatBitsToUint(a)); }
+float rsqLo(float a) { return uintBitsToFloat(0x5f347d74u - (floatBitsToUint(a) >> 1u)); }
+float lum(vec3 c) { return c.b * 0.5 + (c.r * 0.5 + c.g); }
+
+void easuTap(inout vec3 aC, inout float aW, vec2 off, vec2 dir, vec2 len, float lob, float clp, vec3 c) {
+  vec2 v = vec2(off.x * dir.x + off.y * dir.y, off.x * -dir.y + off.y * dir.x) * len;
+  float d2 = min(v.x * v.x + v.y * v.y, clp);
+  float wB = 2.0 / 5.0 * d2 - 1.0;
+  float wA = lob * d2 - 1.0;
+  wB *= wB;
+  wA *= wA;
+  wB = 25.0 / 16.0 * wB - (25.0 / 16.0 - 1.0);
+  float w = wB * wA;
+  aC += c * w;
+  aW += w;
+}
+
+void easuSet(inout vec2 dir, inout float len, float w, float lA, float lB, float lC, float lD, float lE) {
+  float dc = lD - lC, cb = lC - lB;
+  float lenX = rcpLo(max(abs(dc), abs(cb)));
+  float dirX = lD - lB;
+  dir.x += dirX * w;
+  lenX = clamp(abs(dirX) * lenX, 0.0, 1.0);
+  len += lenX * lenX * w;
+  float ec = lE - lC, ca = lC - lA;
+  float lenY = rcpLo(max(abs(ec), abs(ca)));
+  float dirY = lE - lA;
+  dir.y += dirY * w;
+  lenY = clamp(abs(dirY) * lenY, 0.0, 1.0);
+  len += lenY * lenY * w;
+}
+
+void main() {
+  vec2 pp = i_coord * vec2(src_extent) - 0.5;
+  vec2 fp = floor(pp);
+  pp -= fp;
+  ivec2 f = ivec2(fp) + src_offset;
+  //    b c
+  //  e f g h
+  //  i j k l
+  //    n o
+  vec3 b = tap(f + ivec2(0, -1)), c = tap(f + ivec2(1, -1));
+  vec3 e = tap(f + ivec2(-1, 0)), F = tap(f), g = tap(f + ivec2(1, 0)), h = tap(f + ivec2(2, 0));
+  vec3 i = tap(f + ivec2(-1, 1)), j = tap(f + ivec2(0, 1)), k = tap(f + ivec2(1, 1)), l = tap(f + ivec2(2, 1));
+  vec3 n = tap(f + ivec2(0, 2)), o = tap(f + ivec2(1, 2));
+  float bL = lum(b), cL = lum(c), eL = lum(e), fL = lum(F), gL = lum(g), hL = lum(h);
+  float iL = lum(i), jL = lum(j), kL = lum(k), lL = lum(l), nL = lum(n), oL = lum(o);
+
+  vec2 dir = vec2(0.0);
+  float len = 0.0;
+  easuSet(dir, len, (1.0 - pp.x) * (1.0 - pp.y), bL, eL, fL, gL, jL);
+  easuSet(dir, len, pp.x * (1.0 - pp.y),         cL, fL, gL, hL, kL);
+  easuSet(dir, len, (1.0 - pp.x) * pp.y,         fL, iL, jL, kL, nL);
+  easuSet(dir, len, pp.x * pp.y,                 gL, jL, kL, lL, oL);
+
+  vec2 dir2 = dir * dir;
+  float dirR = dir2.x + dir2.y;
+  bool zro = dirR < 1.0 / 32768.0;
+  dirR = zro ? 1.0 : rsqLo(dirR);
+  dir.x = zro ? 1.0 : dir.x;
+  dir *= dirR;
+  len = len * 0.5;
+  len *= len;
+  float stretch = (dir.x * dir.x + dir.y * dir.y) * rcpLo(max(abs(dir.x), abs(dir.y)));
+  vec2 len2 = vec2(1.0 + (stretch - 1.0) * len, 1.0 - 0.5 * len);
+  float lob = 0.5 + ((1.0 / 4.0 - 0.04) - 0.5) * len;
+  float clp = rcpLo(lob);
+
+  vec3 min4 = min(min(F, g), min(j, k));
+  vec3 max4 = max(max(F, g), max(j, k));
+  vec3 aC = vec3(0.0);
+  float aW = 0.0;
+  easuTap(aC, aW, vec2( 0.0, -1.0) - pp, dir, len2, lob, clp, b);
+  easuTap(aC, aW, vec2( 1.0, -1.0) - pp, dir, len2, lob, clp, c);
+  easuTap(aC, aW, vec2(-1.0,  1.0) - pp, dir, len2, lob, clp, i);
+  easuTap(aC, aW, vec2( 0.0,  1.0) - pp, dir, len2, lob, clp, j);
+  easuTap(aC, aW, vec2( 0.0,  0.0) - pp, dir, len2, lob, clp, F);
+  easuTap(aC, aW, vec2(-1.0,  0.0) - pp, dir, len2, lob, clp, e);
+  easuTap(aC, aW, vec2( 1.0,  1.0) - pp, dir, len2, lob, clp, k);
+  easuTap(aC, aW, vec2( 2.0,  1.0) - pp, dir, len2, lob, clp, l);
+  easuTap(aC, aW, vec2( 2.0,  0.0) - pp, dir, len2, lob, clp, h);
+  easuTap(aC, aW, vec2( 1.0,  0.0) - pp, dir, len2, lob, clp, g);
+  easuTap(aC, aW, vec2( 1.0,  2.0) - pp, dir, len2, lob, clp, o);
+  easuTap(aC, aW, vec2( 0.0,  2.0) - pp, dir, len2, lob, clp, n);
+  vec3 pix = min(max4, max(min4, aC / aW));
+  o_color = vec4(pix, 1.0);
+
+  if (s_gamma_bound) {
+    o_color = vec4(
+      texture(s_gamma, o_color.r).r,
+      texture(s_gamma, o_color.g).g,
+      texture(s_gamma, o_color.b).b,
+      o_color.a);
+  }
+}
