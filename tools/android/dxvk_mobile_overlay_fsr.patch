+  static dxvk::mutex           g_overlayMutex;
+  static IDirect3DTexture9*    g_overlayTex = nullptr;
+  static std::vector<VkRect2D> g_overlayRects;
+
+  void SetAndroidOverlay(IDirect3DTexture9* tex, const int32_t* rects, uint32_t n) {
+    std::lock_guard<dxvk::mutex> lock(g_overlayMutex);
+    if (tex) tex->AddRef();
+    if (g_overlayTex) g_overlayTex->Release();
+    g_overlayTex = tex;
+    g_overlayRects.clear();
+    for (uint32_t i = 0; tex && i < n; i++)
+      g_overlayRects.push_back(VkRect2D { { rects[4 * i], rects[4 * i + 1] },
+        { uint32_t(rects[4 * i + 2]), uint32_t(rects[4 * i + 3]) } });
+  }
