   /**
--- /dev/null
+++ b/src/dxvk/shaders/dxvk_present_vert_rot90.vert
@@ -0,0 +1,14 @@
+#version 450
+
+// Port: the present quad for a swap chain pre-rotated by 90 degrees (Android: the display's own orientation, so
+// the compositor shows it as it is instead of rotating every frame on the GPU)
+layout(location = 0) out vec2 o_coord;
+
+void main() {
+  vec2 coord = vec2(
+    float(gl_VertexIndex & 2),
+    float(gl_VertexIndex & 1) * 2.0f);
+
+  o_coord = vec2(coord.y, 1.0f - coord.x);
+  gl_Position = vec4(-1.0f + 2.0f * coord, 0.0f, 1.0f);
+}
--- /dev/null
+++ b/src/dxvk/shaders/dxvk_present_vert_rot270.vert
@@ -0,0 +1,14 @@
+#version 450
+
+// Port: the present quad for a swap chain pre-rotated by 270 degrees (Android: the display's own orientation, so
+// the compositor shows it as it is instead of rotating every frame on the GPU)
+layout(location = 0) out vec2 o_coord;
+
+void main() {
+  vec2 coord = vec2(
+    float(gl_VertexIndex & 2),
+    float(gl_VertexIndex & 1) * 2.0f);
+
+  o_coord = vec2(1.0f - coord.y, coord.x);
+  gl_Position = vec4(-1.0f + 2.0f * coord, 0.0f, 1.0f);
+}
