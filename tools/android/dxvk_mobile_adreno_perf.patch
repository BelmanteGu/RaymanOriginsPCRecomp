+    return str::format(s, " ", d.Width, "x", d.Height, " fmt ", uint32_t(d.Format),
+      (d.Usage & D3DUSAGE_RENDERTARGET) ? " rt" : "", (d.Usage & D3DUSAGE_DEPTHSTENCIL) ? " ds" : "");
