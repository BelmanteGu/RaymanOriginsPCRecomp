+  static bool on() { return target() >= 0 && int(s_frame) == target(); }
+  static uint32_t hashOf(D3D9PixelShader* ps) {
+    if (!ps) return 0;
+    uint32_t h = 2166136261u;
+    for (uint8_t c : ps->GetCommonShader()->GetBytecode()) { h ^= c; h *= 16777619u; }
+    return h;
+  }
+  static void flush() {
+    if (on() && s_draws) Logger::info(str::format("framelog:   ", s_draws, " draws, ", s_prims, " prims (first: ps ", std::hex, s_ps, std::dec,
