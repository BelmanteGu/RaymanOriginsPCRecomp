+  // Port (Rayman Origins PC, Android): DXVK 1.9 made a new VkFramebuffer at every render target change. Qualcomm's
+  // Adreno driver allocates GPU memory in the kernel for each one (vkCreateFramebuffer -> gsl_memory_alloc_pure ->
+  // IOCTL_KGSL_SHAREDMEM_ALLOC): measured in play on a Galaxy Tab S6 Lite, 13% of the game's CPU time, most of its
+  // kernel time. The recent framebuffers are kept (the same attachments and layouts: the same one again) and the least
+  // recently used goes when the cache is full; a framebuffer in use stays alive through its command lists anyway.
+  // DXVK_FB_CACHE=0 turns it off.
+  namespace {
+    struct FbCacheEntry { Rc<DxvkFramebuffer> fb; uint64_t used = 0; };
+    constexpr uint32_t FbCacheSize = 32;
+  }
+
   Rc<DxvkFramebuffer> DxvkDevice::createFramebuffer(
     const DxvkRenderTargets& renderTargets) {
+    static const bool cacheOn = [] { const char* e = std::getenv("DXVK_FB_CACHE"); return !(e && *e == '0'); }();
+    static dxvk::mutex             s_lock;
+    static FbCacheEntry            s_cache[FbCacheSize];
+    static const DxvkDevice*       s_owner = nullptr;
+    static uint64_t                s_clock = 0, s_hits = 0, s_misses = 0;
+
+    std::unique_lock<dxvk::mutex> lock(s_lock, std::defer_lock);
+    if (cacheOn) {
+      lock.lock();
+      if (s_owner != this) {                            // another device: nothing of the last one is reused
+        for (auto& e : s_cache) e = FbCacheEntry();
+        s_owner = this;
+      }
+      for (auto& e : s_cache) {                         // not asked for in the last 512 changes: let it (and the
+        if (e.fb != nullptr && e.used + 512 < s_clock)    // render targets it holds) go, e.g. after a level change
+          e = FbCacheEntry();
+      }
+      for (auto& e : s_cache) {
+        if (e.fb != nullptr && e.fb->hasTargets(renderTargets)) {
+          e.used = ++s_clock;
+          if ((++s_hits & 0xFFFF) == 0)
+            Logger::info(str::format("DXVK: framebuffer cache: ", s_hits, " reused, ", s_misses, " made"));
+          return e.fb;
+        }
+      }
+      s_misses++;
+    }
