+// Port (Rayman Origins PC, analysis): DXVK_FRAMELOG=<frame number> writes that one frame's render target changes,
+// copies, clears and draws in order (the draws between two events as one line, with the first draw's pixel shader: an
+// FNV-1a of its bytecode, and whether stage 0 samples a render target). Off without the variable.
+namespace dxvk { namespace framelog {
+  static int target() { static int t = [] { const char* e = std::getenv("DXVK_FRAMELOG"); return e ? atoi(e) : -1; }(); return t; }
