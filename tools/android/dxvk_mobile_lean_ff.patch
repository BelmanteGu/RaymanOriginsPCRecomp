+  // DXVK_LEAN_FF=1 (Rayman Origins PC port, weak mobile GPUs): shaders without the fixed-function features the game
+  // never turns on: fog, alpha test (and its OpKill), point sprites, user clip planes. DXVK emits them in every shader
+  // behind specialization constants, and a mobile driver that does not fold those pays for them in every pixel.
+  static bool leanFixedFunction() {
+    static const bool lean = [] { const char* e = std::getenv("DXVK_LEAN_FF"); return e && *e && *e != '0'; }();
+    return lean;
+  }
+
   // DXVK_LEAN_SAMPLING=1 (Rayman Origins PC port): see emitTextureSample
